	partition 'GA4 Commerce Sessions' = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(GoogleBigQuery.Database([BillingProject = "mda-platform-2026", UseStorageApi = false, CommandTimeout = #duration(0, 0, 2, 0)]){[Name = "mda-platform-2026.analytics_ga4_commerce_dev.fct_ga4_commerce_session_funnel"]}[Data], "SELECT test_run_id, scenario_id, app_session_id, session_started_at, event_count,#(lf) CASE stage_reached WHEN 4 THEN 'Purchase' WHEN 3 THEN 'Begin Checkout'#(lf) WHEN 2 THEN 'Add to Cart' WHEN 1 THEN 'View Item' ELSE 'No qualifying view' END AS furthest_stage,#(lf) logical_purchases, removal_events#(lf)FROM `mda-platform-2026.analytics_ga4_commerce_dev.fct_ga4_commerce_session_funnel` ORDER BY session_started_at DESC, session_key LIMIT 500", null, [EnableFolding = true])
				in
				    Source

