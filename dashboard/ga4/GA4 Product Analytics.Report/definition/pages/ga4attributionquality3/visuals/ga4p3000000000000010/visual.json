    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Interpretation & limitations",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "18pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Store referrals can replace the apparent acquisition source. The proxy uses the first non-internal source/medium pair.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Multiple pairs within a session flag conflicting information; they do not identify its cause.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Uncertain attribution can distort channel conversion comparisons. Check tagging and referral handling before allocating marketing spend.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Custom session attribution is not official GA4 attribution or default channel grouping. Observed associations do not establish causality.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#64748B"
                    }
                  }
                ]
              }
            ]
          }
