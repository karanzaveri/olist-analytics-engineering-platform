            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Business interpretation",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "18pt",
                      "color": "#172b3a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Product view to cart has the largest observed within-funnel loss in the validated seven-day sample.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172b3a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Stage rates use the preceding qualifying stage as the denominator. Overall purchase rate includes all sessions, including non-entrants.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#64748b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Observed differences do not establish causes. Equal timestamps can qualify together; boundary sessions may be incomplete. Product continuity is not enforced.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#64748b"
                    }
                  }
                ]
              }
            ]
          }
