                "textRuns": [
                  {
                    "value": "Interpretation & limitations",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "18pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Compare purchase rates with session counts. Small device or channel segments can produce unstable observed rates.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Channels use a custom session-attribution proxy, not official GA4 channel grouping or verified acquisition. Unknown and Internal Referral Only are included.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gap = highest minus lowest selected device rate; blank for fewer than two devices. Investigate audience mix and attribution quality. No causal or significance claim.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              }
