table Sessions
	lineageTag: f575fecf-b114-4238-81d8-962e81516a81

	measure 'Total Sessions' = COUNTROWS('Sessions')
		formatString: #,##0
		lineageTag: ec6c7aad-0a90-435c-b179-90b1af02e754

	measure 'Pseudonymous Users' = DISTINCTCOUNT('Sessions'[user_pseudo_id])
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: ad9755c1-4d50-4f98-a902-0c12ab86fafd

	measure 'Observed Events' = SUM('Sessions'[total_events])
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: 2d33a638-07ee-422d-9f7a-14245983d7a6

	measure 'Viewed Product Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[funnel_viewed_product] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: 11651cd7-1808-4e9c-9835-23bc91a02636

	measure 'Added to Cart Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[funnel_added_to_cart] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: d698aaa3-0c33-47f0-8c49-d9dd2f8e82ae

	measure 'Started Checkout Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[funnel_started_checkout] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: 302da0c6-cf5b-4c55-b89e-ac5883cbd843

	measure 'Sequential Purchasing Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[funnel_purchased] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Overview / Volume
		lineageTag: 632343ef-3c54-4797-87ec-bb706bf664ec

	measure 'Funnel Entry Rate' = DIVIDE([Viewed Product Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: 758015fe-78e6-4194-8d58-415493e0c4ec

	measure 'View-to-Cart Rate' = DIVIDE([Added to Cart Sessions], [Viewed Product Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: 75a53f97-b718-45f8-88c2-a008637be9b8

	measure 'Cart-to-Checkout Rate' = DIVIDE([Started Checkout Sessions], [Added to Cart Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: 37b60cd5-05f0-49fa-ac5d-38eba7f36b37

	measure 'Checkout-to-Purchase Rate' = DIVIDE([Sequential Purchasing Sessions], [Started Checkout Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: f9b0e5e0-d71b-4330-9524-5bb34ec4b966

	measure 'View-to-Purchase Rate' = DIVIDE([Sequential Purchasing Sessions], [Viewed Product Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: 487b3565-a540-4849-a763-24f5e81622c6

	measure 'Overall Sequential Session Purchase Rate' = DIVIDE([Sequential Purchasing Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Overview / Conversion
		lineageTag: ebaf5440-40b3-4b56-8687-6f9348de28a7

	measure 'Drop-off After Product View' = [Viewed Product Sessions] - [Added to Cart Sessions]
		formatString: #,##0
		displayFolder: Overview / Drop-off
		lineageTag: 0b9d4e15-b5c1-42c0-870d-918dfa6ab48b

	measure 'Drop-off After Product View Rate' = DIVIDE([Drop-off After Product View], [Viewed Product Sessions])
		formatString: 0.00%
		displayFolder: Overview / Drop-off
		lineageTag: 72f9b83c-93a5-4fc9-9637-fe57e83ac062

	measure 'Drop-off After Add to Cart' = [Added to Cart Sessions] - [Started Checkout Sessions]
		formatString: #,##0
		displayFolder: Overview / Drop-off
		lineageTag: d975be23-d746-45bc-8409-0b82d1d9bca0

	measure 'Drop-off After Add to Cart Rate' = DIVIDE([Drop-off After Add to Cart], [Added to Cart Sessions])
		formatString: 0.00%
		displayFolder: Overview / Drop-off
		lineageTag: a8375a8c-55e5-4ec5-84ce-7577480a6f06

	measure 'Drop-off After Checkout' = [Started Checkout Sessions] - [Sequential Purchasing Sessions]
		formatString: #,##0
		displayFolder: Overview / Drop-off
		lineageTag: 1c99bab8-66aa-433d-9811-3ef189a51ecf

	measure 'Drop-off After Checkout Rate' = DIVIDE([Drop-off After Checkout], [Started Checkout Sessions])
		formatString: 0.00%
		displayFolder: Overview / Drop-off
		lineageTag: a8b58609-0ce9-4774-bcbc-8bd23bf753c9

	measure 'Not Entered Sessions' = [Total Sessions] - [Viewed Product Sessions]
		formatString: #,##0
		displayFolder: Overview / Drop-off
		lineageTag: 44cc59a5-19b1-4596-85eb-3f1fd73b3064

	measure 'Funnel Stage Sessions' = SWITCH(SELECTEDVALUE('Funnel Stages'[Stage Order]), 1, [Viewed Product Sessions], 2, [Added to Cart Sessions], 3, [Started Checkout Sessions], 4, [Sequential Purchasing Sessions], BLANK())
		formatString: #,##0
		displayFolder: Overview / Chart Helpers
		lineageTag: de509818-21da-4760-b22b-0f9d0fecee0c

	measure 'Stage Conversion Rate' = SWITCH(SELECTEDVALUE('Funnel Stages'[Stage Order]), 1, [View-to-Cart Rate], 2, [Cart-to-Checkout Rate], 3, [Checkout-to-Purchase Rate], BLANK())
		formatString: 0.00%
		displayFolder: Overview / Chart Helpers
		lineageTag: 491ac801-2893-4389-bb73-7ecf36dd3512

	measure 'Stage Drop-off Rate' = SWITCH(SELECTEDVALUE('Funnel Stages'[Stage Order]), 1, [Drop-off After Product View Rate], 2, [Drop-off After Add to Cart Rate], 3, [Drop-off After Checkout Rate], BLANK())
		formatString: 0.00%
		displayFolder: Overview / Chart Helpers
		lineageTag: 3db6e015-4425-41bf-abe4-453b45aff248

	measure 'Stage Drop-off Sessions' = SWITCH(SELECTEDVALUE('Funnel Stages'[Stage Order]), 1, [Drop-off After Product View], 2, [Drop-off After Add to Cart], 3, [Drop-off After Checkout], BLANK())
		formatString: #,##0
		displayFolder: Overview / Chart Helpers
		lineageTag: 6b5761c0-ccf5-4cd8-ab91-96057eca5909

	measure 'Desktop Purchase Rate' = CALCULATE([Overall Sequential Session Purchase Rate], KEEPFILTERS('Sessions'[device_category] = "desktop"))
		formatString: 0.00%
		displayFolder: Device & Acquisition / Comparisons
		lineageTag: 15dfe6eb-2a08-4da1-a246-41e3153bbb67

	measure 'Mobile Purchase Rate' = CALCULATE([Overall Sequential Session Purchase Rate], KEEPFILTERS('Sessions'[device_category] = "mobile"))
		formatString: 0.00%
		displayFolder: Device & Acquisition / Comparisons
		lineageTag: e800debb-0106-4323-9e99-0c5b551da4f9

	measure 'Tablet Purchase Rate' = CALCULATE([Overall Sequential Session Purchase Rate], KEEPFILTERS('Sessions'[device_category] = "tablet"))
		formatString: 0.00%
		displayFolder: Device & Acquisition / Comparisons
		lineageTag: 1fb4c8a6-a6a0-4ccf-8ac5-06d742bee1e1

	measure 'Observed Device Purchase Rate Gap' = VAR Rates = FILTER(ADDCOLUMNS(FILTER(VALUES('Sessions'[device_category]), 'Sessions'[device_category] IN {"desktop", "mobile", "tablet"}), "__Rate", [Overall Sequential Session Purchase Rate]), NOT ISBLANK([__Rate])) RETURN IF(COUNTROWS(Rates) < 2, BLANK(), (MAXX(Rates, [__Rate]) - MINX(Rates, [__Rate])) * 100)
		formatString: 0.00" pp"
		displayFolder: Device & Acquisition / Comparisons
		lineageTag: 7b1a8b78-1c56-446a-b3c0-e5a15c71def8

	measure 'Attributed Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[attribution_status] = "Attributed")), 0)
		formatString: #,##0
		displayFolder: Attribution & Data Quality
		lineageTag: f803cb06-9ff1-4398-bcf9-8e70ce14ee18

	measure 'Attributed Session Share' = DIVIDE([Attributed Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
		lineageTag: f8a50f19-cc29-4f3a-a947-31d2712b74b5

	measure 'Unknown Attribution Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[attribution_status] = "Unknown")), 0)
		formatString: #,##0
		displayFolder: Attribution & Data Quality
		lineageTag: 87dc8d99-817b-41c5-a42f-73d537dab674

	measure 'Unknown Attribution Session Share' = DIVIDE([Unknown Attribution Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
		lineageTag: f28595a9-3030-4c6a-a8ee-c00eae1b62f8

	measure 'Internal Referral Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[has_internal_referral] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Attribution & Data Quality
		lineageTag: c481534f-bfed-4411-b12a-985f4d282e46

	measure 'Internal Referral Session Share' = DIVIDE([Internal Referral Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
		lineageTag: 3753db2d-5a69-48a3-995a-ba8588d8ee4f

	measure 'Conflicting Source Sessions' = COALESCE(CALCULATE([Total Sessions], KEEPFILTERS('Sessions'[has_conflicting_sources] = TRUE())), 0)
		formatString: #,##0
		displayFolder: Attribution & Data Quality
		lineageTag: 51f57397-28c1-49d5-bd25-e2ae674caf44

	measure 'Conflicting Source Session Share' = DIVIDE([Conflicting Source Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
		lineageTag: b475f97c-2d69-4b50-9c56-98b4062cbc5d

	measure 'Attribution Status Session Share' = DIVIDE([Total Sessions], CALCULATE([Total Sessions], ALLSELECTED('Sessions'[attribution_status])))
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
		lineageTag: dc86696f-a128-4df5-a81c-eb5d1d32864a

	measure 'Attribution Quality Flag Sessions' = SWITCH(SELECTEDVALUE('Attribution Quality Flags'[Flag Order]), 1, [Internal Referral Sessions], 2, [Conflicting Source Sessions], BLANK())
		formatString: #,##0
		displayFolder: Attribution & Data Quality
		lineageTag: 48e88d7f-0725-40a5-9f71-3bb4714f9f75

	measure 'Attribution Quality Flag Session Share' = DIVIDE([Attribution Quality Flag Sessions], [Total Sessions])
		formatString: 0.00%
		displayFolder: Attribution & Data Quality
